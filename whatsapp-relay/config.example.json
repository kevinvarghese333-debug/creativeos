{
  // Reference copy. `bash setup.sh` writes the real file to data/whatsapp-relay/config.json, from
  // settings.json if the package has one, else from your answers. Change numbers and accounts from
  // WhatsApp (send !settings to the bot), or edit that file; it reloads by itself.
  // Numbers: country code + number, digits only (919847012345). A plain 10-digit mobile also works.

  // Your own WhatsApp number (the one you chat with Hermes from).
  "owner_number": "",
  "timezone": "Asia/Kolkata",

  // Keep the agent silent in groups. Leave this true.
  "silence_groups": true,

  "forwarding": {
    "enabled": true,
    // The number whose files get forwarded.
    "source_numbers": [],
    // Group names to find by themselves while `bash setup.sh groups` runs, e.g. ["AREA MANAGERS", "MANAGERS"].
    // Emoji and capitals don't matter. Groups can also be added by typing !addgroup inside them.
    "target_group_names": [],
    // Normally empty (found groups are kept in groups.json). Only paste IDs here
    // (like "120363012345678901@g.us") if a group can't be found or added any other way.
    "target_groups": [],
    // Which files are forwarded: "image", "document", "video", "audio".
    // ["image"] = only pictures (a picture sent "as a document" counts as a picture).
    "forward_kinds": ["image", "document", "video", "audio"],
    // false = only files (photos, PDFs, documents, videos, voice notes) are forwarded, not plain text.
    "forward_text_messages": false,
    // Optional text put in front of the original caption, e.g. "From office: ". Empty = caption unchanged.
    "caption_prefix": "",
    // "failures" = message you only when a forward fails. "always" = also confirm every forward. "never".
    "notify_owner": "failures",
    "delay_between_sends_seconds": 1.5
  },

  "statement": {
    "enabled": true,
    // The firm's number, which sends statement screenshots straight to the bot.
    // Empty = only statements you forward yourself (with no caption) are read.
    "sender_numbers": [],
    // Accounts tracked separately when the statements cover more than one, e.g.
    // [{"number": "1001", "name": "Asha"}, {"number": "1002", "name": "Ravi"}]. Empty = one combined tracker.
    "accounts": [],
    // The daily credit to look for.
    "expected_amount": 2000,
    "amount_tolerance": 0,
    // Words that appear in that entry's description, e.g. the last 4 digits of the account.
    // Empty = every credit of exactly the expected amount counts.
    "match_keywords": [],
    // Screenshots arriving within this many seconds of each other are read together.
    "batch_seconds": 45,
    "nudge_after_days": 7,
    "nudge_repeat_days": 2
  },

  "calendar": {
    // Days the firm never credits. Holidays can also be added from WhatsApp with !holiday 2026-10-20
    "weekly_off": ["sunday"],
    "holidays": []
  },

  "gemini": {
    "model": "gemini-flash-latest",
    "timeout_seconds": 120
  }
}
